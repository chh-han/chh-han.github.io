---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign all_pages = site.html_pages | where_exp: "p", "p.sitemap != false" %}
  {% for page in all_pages %}
    {% unless page.url == "/sitemap.xml" or page.url == "/404.html" %}
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}{{ page.url | replace: "index.html", "" }}</loc>
    {% if page.last_modified_at %}
    <lastmod>{{ page.last_modified_at | date_to_xmlschema }}</lastmod>
    {% elsif page.date %}
    <lastmod>{{ page.date | date_to_xmlschema }}</lastmod>
    {% endif %}
  </url>
    {% endunless %}
  {% endfor %}

  {% for collection in site.collections %}
    {% if collection.label == "news" or collection.label == "publications" or collection.label == "showcase" %}
      {% for doc in collection.docs %}
        {% if doc.sitemap != false %}
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}{{ doc.url | replace: "index.html", "" }}</loc>
    {% if doc.last_modified_at %}
    <lastmod>{{ doc.last_modified_at | date_to_xmlschema }}</lastmod>
    {% elsif doc.date %}
    <lastmod>{{ doc.date | date_to_xmlschema }}</lastmod>
    {% endif %}
  </url>
        {% endif %}
      {% endfor %}
    {% endif %}
  {% endfor %}
</urlset>
