---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Creation from '@/components/pages/Creation';
import { buildCreationJsonLd } from '@/data/site';

const jsonLd = buildCreationJsonLd(Astro.site?.toString());
---

<BaseLayout
  title="Creation — ChangHeon Han"
  description="Music production catalog — seven years of releases, Spotify editorial playlist features, and brand collaborations."
  jsonLd={jsonLd}
>
  <Creation client:load />
</BaseLayout>
